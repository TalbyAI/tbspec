@prefix tbspec: <https://talby.ai/ontology/tbspec#> .
@prefix proc: <https://talby.ai/ontology/process#> .
@prefix sm: <https://talby.ai/ontology/state-machine#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://talby.ai/ontology/process/0.1.0/shapes> a tbspec:ShapesGraph .
<https://talby.ai/ontology/process/0.1.0/shapes#PlanShape> a sh:NodeShape ; sh:targetClass p-plan:Plan ; sh:nodeKind sh:BlankNodeOrIRI .

<https://talby.ai/ontology/process/0.1.0/shapes#StepShape> a sh:NodeShape ; sh:targetClass p-plan:Step ; sh:targetSubjectsOf p-plan:isStepOfPlan ; sh:targetSubjectsOf p-plan:hasInputVar ; sh:targetSubjectsOf p-plan:hasOutputVar ; sh:targetSubjectsOf proc:responsibleParty ; sh:targetObjectsOf p-plan:isInputVarOf ; sh:targetObjectsOf p-plan:isOutputVarOf ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Step ; sh:property [ sh:path p-plan:isStepOfPlan ; sh:minCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Plan ] ; sh:property [ sh:path proc:responsibleParty ; sh:nodeKind sh:IRI ] ; sh:property [ sh:path [ sh:alternativePath ( p-plan:hasInputVar [ sh:inversePath p-plan:isInputVarOf ] ) ] ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Variable ] ; sh:property [ sh:path [ sh:alternativePath ( p-plan:hasOutputVar [ sh:inversePath p-plan:isOutputVarOf ] ) ] ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Variable ] ; sh:node [ sh:sparql [ sh:message "Step and effective variable must share a plan."@en ; sh:select """PREFIX tbspec: <https://talby.ai/ontology/tbspec#>
PREFIX proc: <https://talby.ai/ontology/process#>
PREFIX sm: <https://talby.ai/ontology/state-machine#>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this WHERE { $this (p-plan:hasInputVar|p-plan:hasOutputVar|^p-plan:isInputVarOf|^p-plan:isOutputVarOf) ?v . FILTER NOT EXISTS { $this p-plan:isStepOfPlan ?plan . ?v p-plan:isVariableOfPlan ?plan } }""" ] ] .

<https://talby.ai/ontology/process/0.1.0/shapes#VariableShape> a sh:NodeShape ; sh:targetClass p-plan:Variable ; sh:targetSubjectsOf p-plan:isVariableOfPlan ; sh:targetSubjectsOf p-plan:isInputVarOf ; sh:targetSubjectsOf p-plan:isOutputVarOf ; sh:targetObjectsOf p-plan:hasInputVar ; sh:targetObjectsOf p-plan:hasOutputVar ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Variable ; sh:property [ sh:path p-plan:isVariableOfPlan ; sh:minCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Plan ] ; sh:property [ sh:path [ sh:alternativePath ( p-plan:isOutputVarOf [ sh:inversePath p-plan:hasOutputVar ] ) ] ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Step ] ; sh:property [ sh:path [ sh:alternativePath ( p-plan:isInputVarOf [ sh:inversePath p-plan:hasInputVar ] ) ] ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Step ] .

<https://talby.ai/ontology/process/0.1.0/shapes#DecisionShape> a sh:NodeShape ; sh:targetClass proc:Decision ; sh:class p-plan:Step ; sh:nodeKind sh:BlankNodeOrIRI .

<https://talby.ai/ontology/process/0.1.0/shapes#FlowShape> a sh:NodeShape ; sh:targetClass proc:Flow ; sh:targetSubjectsOf proc:source ; sh:targetSubjectsOf proc:target ; sh:targetSubjectsOf proc:inPlan ; sh:targetSubjectsOf proc:condition ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class proc:Flow ; sh:property [ sh:path proc:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Step ] ; sh:property [ sh:path proc:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Step ] ; sh:property [ sh:path proc:inPlan ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class p-plan:Plan ] ; sh:property [ sh:path proc:condition ; sh:maxCount 1 ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ] ; sh:node [ sh:sparql [ sh:message "Flow endpoints must belong to its plan."@en ; sh:select """PREFIX tbspec: <https://talby.ai/ontology/tbspec#>
PREFIX proc: <https://talby.ai/ontology/process#>
PREFIX sm: <https://talby.ai/ontology/state-machine#>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this WHERE { $this proc:inPlan ?plan ; proc:source ?s ; proc:target ?t . FILTER (NOT EXISTS { ?s p-plan:isStepOfPlan ?plan } || NOT EXISTS { ?t p-plan:isStepOfPlan ?plan }) }""" ] ] .
