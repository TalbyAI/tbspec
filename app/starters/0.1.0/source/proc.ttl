@prefix tbspec: <https://talby.ai/ontology/tbspec#> .
@prefix proc: <https://talby.ai/ontology/process#> .
@prefix sm: <https://talby.ai/ontology/state-machine#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://talby.ai/ontology/process> a owl:Ontology ; owl:versionIRI <https://talby.ai/ontology/process/0.1.0> ; rdfs:label "proc vocabulary"@en .
<https://talby.ai/ontology/process> owl:imports <http://purl.org/net/p-plan#> .
proc:Decision a owl:Class ; rdfs:label "Decision"@en ; rdfs:comment "A descriptive process step representing a choice."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:Flow a owl:Class ; rdfs:label "Flow"@en ; rdfs:comment "An immediate descriptive connection between two steps in a plan."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:source a owl:ObjectProperty ; rdfs:label "source"@en ; rdfs:comment "The source step of a flow."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:target a owl:ObjectProperty ; rdfs:label "target"@en ; rdfs:comment "The target step of a flow."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:inPlan a owl:ObjectProperty ; rdfs:label "in Plan"@en ; rdfs:comment "The local plan containing a flow."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:responsibleParty a owl:ObjectProperty ; rdfs:label "responsible Party"@en ; rdfs:comment "An IRI person, organization or role responsible for a step."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:condition a owl:DatatypeProperty ; rdfs:label "condition"@en ; rdfs:comment "An optional descriptive condition on a flow; never executable."@en ; rdfs:isDefinedBy <https://talby.ai/ontology/process> .
proc:Decision rdfs:subClassOf p-plan:Step .
