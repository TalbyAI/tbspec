@prefix tbspec: <https://talby.ai/ontology/tbspec#> .
@prefix proc: <https://talby.ai/ontology/process#> .
@prefix sm: <https://talby.ai/ontology/state-machine#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://talby.ai/ontology/state-machine/0.1.0/shapes> a tbspec:ShapesGraph .
<https://talby.ai/ontology/state-machine/0.1.0/shapes#StateMachineShape> a sh:NodeShape ; sh:targetClass sm:StateMachine ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node [ sh:sparql [ sh:message "A machine has at most one initial state."@en ; sh:select """PREFIX tbspec: <https://talby.ai/ontology/tbspec#>
PREFIX proc: <https://talby.ai/ontology/process#>
PREFIX sm: <https://talby.ai/ontology/state-machine#>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this WHERE { ?s a sm:InitialState ; sm:inMachine $this . ?s2 a sm:InitialState ; sm:inMachine $this . FILTER (?s != ?s2) }""" ] ] .

<https://talby.ai/ontology/state-machine/0.1.0/shapes#StateShape> a sh:NodeShape ; sh:targetClass sm:State ; sh:nodeKind sh:BlankNodeOrIRI ; sh:property [ sh:path sm:inMachine ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class sm:StateMachine ] .

<https://talby.ai/ontology/state-machine/0.1.0/shapes#InitialStateShape> a sh:NodeShape ; sh:targetClass sm:InitialState ; sh:class sm:State .

<https://talby.ai/ontology/state-machine/0.1.0/shapes#FinalStateShape> a sh:NodeShape ; sh:targetClass sm:FinalState ; sh:class sm:State ; sh:node [ sh:sparql [ sh:message "A final state cannot have an outgoing transition."@en ; sh:select """PREFIX tbspec: <https://talby.ai/ontology/tbspec#>
PREFIX proc: <https://talby.ai/ontology/process#>
PREFIX sm: <https://talby.ai/ontology/state-machine#>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this WHERE { ?transition sm:source $this . }""" ] ] .

<https://talby.ai/ontology/state-machine/0.1.0/shapes#TransitionShape> a sh:NodeShape ; sh:targetClass sm:Transition ; sh:targetSubjectsOf sm:source ; sh:targetSubjectsOf sm:target ; sh:targetSubjectsOf sm:event ; sh:targetSubjectsOf sm:condition ; sh:targetSubjectsOf sm:action ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class sm:Transition ; sh:property [ sh:path sm:inMachine ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class sm:StateMachine ] ; sh:property [ sh:path sm:source ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class sm:State ] ; sh:property [ sh:path sm:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:BlankNodeOrIRI ; sh:class sm:State ] ; sh:property [ sh:path sm:event ; sh:maxCount 1 ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ] ; sh:property [ sh:path sm:condition ; sh:maxCount 1 ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ] ; sh:property [ sh:path sm:action ; sh:maxCount 1 ; sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ] ; sh:node [ sh:sparql [ sh:message "Transition endpoints must belong to its machine."@en ; sh:select """PREFIX tbspec: <https://talby.ai/ontology/tbspec#>
PREFIX proc: <https://talby.ai/ontology/process#>
PREFIX sm: <https://talby.ai/ontology/state-machine#>
PREFIX p-plan: <http://purl.org/net/p-plan#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this WHERE { $this sm:inMachine ?machine ; sm:source ?s ; sm:target ?t . FILTER (NOT EXISTS { ?s sm:inMachine ?machine } || NOT EXISTS { ?t sm:inMachine ?machine }) }""" ] ] .

[] a sh:NodeShape ; sh:targetSubjectsOf sm:inMachine ; sh:or ( [ sh:class sm:State ] [ sh:class sm:Transition ] ) .
