xsd:positiveInteger a rdfs:Datatype ; rdfs:label "positiveInteger"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:int a rdfs:Datatype ; rdfs:label "int"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:long a rdfs:Datatype ; rdfs:label "long"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:unsignedInt a rdfs:Datatype ; rdfs:label "unsignedInt"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:unsignedLong a rdfs:Datatype ; rdfs:label "unsignedLong"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:duration a rdfs:Datatype ; rdfs:label "duration"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
