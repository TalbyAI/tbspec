xsd:float a rdfs:Datatype ; rdfs:label "float"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:date a rdfs:Datatype ; rdfs:label "date"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:dateTime a rdfs:Datatype ; rdfs:label "dateTime"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:anyURI a rdfs:Datatype ; rdfs:label "anyURI"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
