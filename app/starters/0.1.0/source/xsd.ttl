xsd:string a rdfs:Datatype ; rdfs:label "string"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
xsd:boolean a rdfs:Datatype ; rdfs:label "boolean"@en ; rdfs:isDefinedBy <http://www.w3.org/2001/XMLSchema> .
