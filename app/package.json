{
  "name": "tbspec",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "tbspec": "dist/cli.js"
  },
  "files": [
    "dist",
    "starters"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc && vite build web --config vite.config.ts --outDir ../dist/web --emptyOutDir && node scripts/prepare-artifact.mjs",
    "verify:packed": "node scripts/verify-packed-application.mjs",
    "prepare-release": "node scripts/prepare-release.mjs",
    "publish-release": "node scripts/publish-release.mjs",
    "verify-release": "node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p web/tsconfig.json && tsc -p tsconfig.vite.json",
    "test": "node --test tests/*.test.ts",
    "test:serial": "node --test --test-concurrency=1 tests/*.test.ts",
    "prepack": "npm run build"
  },
  "bundleDependencies": true,
  "dependencies": {
    "@comunica/query-sparql-rdfjs-lite": "5.4.1",
    "@comunica/utils-bindings-factory": "5.4.0",
    "@traqula/parser-sparql-1-1": "1.4.0",
    "@unicode/unicode-15.0.0": "1.6.17",
    "n3": "2.7.12",
    "rdfxml-streaming-parser": "3.3.0",
    "shacl-engine": "1.1.2",
    "smol-toml": "1.9.0",
    "xspattern": "3.1.0"
  },
  "devDependencies": {
    "@types/n3": "1.26.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
